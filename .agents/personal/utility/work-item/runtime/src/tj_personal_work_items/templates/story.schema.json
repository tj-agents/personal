{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "story work item",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "title", "summary", "persona", "goal", "benefit", "acceptance"],
  "properties": {
    "kind": {"type": "string", "const": "story", "minLength": 1, "pattern": "\\S", "maxLength": 65536},
    "title": {"type": "string", "maxLength": 256, "minLength": 1, "pattern": "\\S"},
    "summary": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 65536},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"], "minLength": 1, "pattern": "\\S", "maxLength": 65536},
    "owner": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 65536},
    "links": {"type": "array", "items": {"type": "string"}},
    "legacy_ids": {"type": "array", "items": {"type": "string"}},
    "persona": {"type": "string", "title": "User or role", "minLength": 1, "pattern": "\\S", "maxLength": 65536},
    "goal": {"type": "string", "title": "Goal", "minLength": 1, "pattern": "\\S", "maxLength": 65536},
    "benefit": {"type": "string", "title": "Benefit", "minLength": 1, "pattern": "\\S", "maxLength": 65536},
    "acceptance": {"type": "string", "title": "Acceptance criteria", "minLength": 1, "pattern": "\\S", "maxLength": 65536}
  }
}
