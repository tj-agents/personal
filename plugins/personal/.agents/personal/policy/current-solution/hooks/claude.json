{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/personal/policy/current-solution/scripts/session-context.py"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/personal/policy/current-solution/scripts/clean_cut.py"
            ]
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ]
  }
}
