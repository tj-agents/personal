{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/personal/policy/current-solution/scripts/session-context.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/personal/policy/current-solution/scripts/session-context.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/personal/policy/current-solution/scripts/clean_cut.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/personal/policy/current-solution/scripts/clean_cut.py\"",
            "timeout": 30
          }
        ],
        "matcher": "Bash|exec_command|unified_exec|local_shell|shell"
      }
    ]
  }
}
