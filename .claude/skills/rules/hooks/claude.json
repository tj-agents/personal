{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/personal/policy/rules/scripts/clean_cut.py"
            ],
            "onFailure": "block"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ]
  }
}
